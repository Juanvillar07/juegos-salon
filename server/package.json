  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
