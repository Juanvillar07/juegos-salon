{
  "name": "@typeracer/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./carrera-de-silabas": {
      "types": "./dist/games/carrera-de-silabas/index.d.ts",
      "default": "./dist/games/carrera-de-silabas/index.js"
    },
    "./cancha-rapida": {
      "types": "./dist/games/cancha-rapida/index.d.ts",
      "default": "./dist/games/cancha-rapida/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  }
}
