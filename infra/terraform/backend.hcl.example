# Copia este archivo como backend.hcl (no se versiona) con los valores del output backend_config
# de infra/bootstrap, y luego: terraform init -backend-config=backend.hcl
bucket       = "salon-de-juegos-tfstate-123456789012"
key          = "salon-de-juegos/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
